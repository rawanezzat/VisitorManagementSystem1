@using Microsoft.Extensions.Localization
@inject IStringLocalizer<VisitorManagementSystem.Resources.SharedResource> Localizer

@model VisitorManagementSystem.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = Localizer["Dashboard"];
}





<style>

    /* =========================================================
           GLOBAL
        ========================================================= */

    :root {
        --primary: #12256b;
        --primary-light: #1e3a8f;
        --primary-soft: #eef2ff;
        --success: #1f9d55;
        --success-soft: #eaf8f0;
        --danger: #dc3545;
        --danger-soft: #fff0f1;
        --warning: #f59e0b;
        --warning-soft: #fff7e6;
        --info: #0ea5e9;
        --info-soft: #eaf7fd;
        --bg: #f5f7fb;
        --card: #ffffff;
        --text: #172033;
        --muted: #718096;
        --border: #e7eaf0;
        --radius: 14px;
        --shadow: 0 4px 20px rgba(18, 37, 107, .07);
        --shadow-hover: 0 8px 28px rgba(18, 37, 107, .12);
    }

    * {
        box-sizing: border-box;
    }

    body {
        background: var(--bg);
        color: var(--text);
    }

    /* =========================================================
           CONTAINER
        ========================================================= */

    .dashboard-container {
        width: 100%;
        max-width: 1600px;
        margin: 0 auto;
        padding: 24px;
    }

    /* =========================================================
           TOP BAR
        ========================================================= */

    .hero-topbar {
        background: linear-gradient(135deg, var(--primary), var(--primary-light));
        color: #fff;
        border-radius: 16px;
        padding: 14px 20px;
        margin-bottom: 25px;
        box-shadow: 0 6px 24px rgba(18, 37, 107, .15);
    }

    .topbar-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
    }

    .system-title-wrapper {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .system-icon {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255,255,255,.15);
        border-radius: 10px;
        font-size: 18px;
    }

    .system-title {
        font-size: 1rem;
        font-weight: 700;
        letter-spacing: .2px;
    }

    .system-subtitle {
        font-size: .72rem;
        opacity: .7;
        margin-top: 2px;
    }

    /* =========================================================
           LANGUAGE
        ========================================================= */

    .language-switcher {
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 4px;
        background: rgba(255,255,255,.10);
        border-radius: 9px;
    }

    .language-btn {
        color: rgba(255,255,255,.75);
        text-decoration: none;
        font-size: .76rem;
        font-weight: 700;
        padding: 6px 11px;
        border-radius: 6px;
        transition: .2s;
    }

        .language-btn:hover {
            color: #fff;
            background: rgba(255,255,255,.12);
        }

        .language-btn.active {
            color: var(--primary);
            background: #fff;
        }

    /* =========================================================
           PAGE HEADER
        ========================================================= */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 22px;
    }

    .page-title {
        margin: 0;
        color: var(--primary);
        font-size: 1.75rem;
        font-weight: 800;
        letter-spacing: -.4px;
    }

    .page-subtitle {
        margin: 5px 0 0;
        color: var(--muted);
        font-size: .88rem;
    }

    .add-visit-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 42px;
        padding: 9px 17px;
        border: none;
        border-radius: 9px;
        background: var(--primary);
        color: #fff;
        font-size: .82rem;
        font-weight: 700;
        text-decoration: none;
        transition: .2s;
        box-shadow: 0 4px 12px rgba(18,37,107,.18);
    }

        .add-visit-btn:hover {
            color: #fff;
            background: var(--primary-light);
            transform: translateY(-1px);
        }

    /* =========================================================
           STATISTICS
        ========================================================= */

    .statistics-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 22px;
    }

    .stat-card {
        position: relative;
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 18px;
        box-shadow: var(--shadow);
        overflow: hidden;
        transition: .25s;
    }

        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-hover);
        }

        .stat-card::after {
            content: "";
            position: absolute;
            right: -25px;
            bottom: -35px;
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: var(--primary-soft);
        }

    .stat-content {
        position: relative;
        z-index: 2;
    }

    .stat-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 13px;
    }

    .stat-label {
        color: var(--muted);
        font-size: .74rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .3px;
    }

    .stat-icon {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: var(--primary-soft);
        color: var(--primary);
        font-size: 17px;
        font-weight: 800;
    }

    .stat-value {
        margin: 0;
        color: var(--primary);
        font-size: 1.9rem;
        font-weight: 800;
        line-height: 1;
    }

    .stat-description {
        margin-top: 7px;
        color: var(--muted);
        font-size: .7rem;
    }

    .stat-card.inside .stat-icon {
        color: var(--success);
        background: var(--success-soft);
    }

    .stat-card.inside .stat-value {
        color: var(--success);
    }

    .stat-card.checked .stat-icon {
        color: var(--info);
        background: var(--info-soft);
    }

    .stat-card.checked .stat-value {
        color: var(--info);
    }

    .today-view-btn {
        width: 36px;
        height: 36px;
        border: none;
        border-radius: 8px;
        background: #eef2ff;
        color: #1e3a8f;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .today-view-btn:hover {
            background: #1e3a8f;
            color: white;
        }

        .today-view-btn i {
            font-size: 17px;
        }
    /* =========================================================
           DASHBOARD CARDS
        ========================================================= */

    .dashboard-card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        margin-bottom: 20px;
        overflow: hidden;
    }

    .card-header-custom {
        padding: 16px 20px;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
    }

    .card-title-custom {
        margin: 0;
        color: var(--primary);
        font-size: .96rem;
        font-weight: 800;
    }

    .card-subtitle-custom {
        margin: 3px 0 0;
        color: var(--muted);
        font-size: .72rem;
    }

    .card-body-custom {
        padding: 18px 20px;
    }

    /* =========================================================
           FILTERS
        ========================================================= */

    .filter-grid {
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        gap: 14px;
    }

    .filter-field {
        grid-column: span 3;
    }

    .filter-search {
        grid-column: span 6;
    }

    .filter-buttons {
        grid-column: span 3;
        display: flex;
        align-items: flex-end;
        gap: 8px;
    }

    .filter-field label,
    .filter-search label {
        display: block;
        margin-bottom: 6px;
        color: var(--text);
        font-size: .72rem;
        font-weight: 700;
    }

    .form-control,
    .form-select {
        min-height: 40px;
        border: 1px solid var(--border);
        border-radius: 8px;
        color: var(--text);
        font-size: .8rem;
        background: #fff;
        transition: .2s;
    }

        .form-control::placeholder {
            color: #a0aec0;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--primary-light);
            box-shadow: 0 0 0 3px rgba(30,58,143,.09);
        }

    .filter-btn {
        min-height: 40px;
        border: none;
        border-radius: 8px;
        padding: 8px 15px;
        font-size: .78rem;
        font-weight: 700;
    }

    .filter-btn-primary {
        background: var(--primary);
        color: #fff;
    }

        .filter-btn-primary:hover {
            background: var(--primary-light);
            color: #fff;
        }

    .filter-btn-reset {
        background: #f3f4f6;
        color: #4a5568;
    }

        .filter-btn-reset:hover {
            background: #e5e7eb;
            color: var(--text);
        }

    /* =========================================================
           TABLE HEADER
        ========================================================= */

    .table-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 16px 20px;
        border-bottom: 1px solid var(--border);
    }

    .table-actions {
        display: flex;
        gap: 7px;
    }

    .export-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 36px;
        padding: 7px 12px;
        border-radius: 8px;
        border: 1px solid var(--border);
        background: #fff;
        color: var(--primary);
        text-decoration: none;
        font-size: .74rem;
        font-weight: 700;
        transition: .2s;
    }

        .export-btn:hover {
            background: var(--primary-soft);
            color: var(--primary);
        }

    /* =========================================================
           TABLE
        ========================================================= */

    .table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    #visitsTable {
        width: 100%;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
        min-width: 1050px;
    }

        #visitsTable thead th {
            background: #f8f9fc;
            color: #596579;
            border-bottom: 1px solid var(--border);
            border-top: none;
            padding: 12px 15px;
            font-size: .69rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .3px;
            white-space: nowrap;
        }

        #visitsTable tbody td {
            padding: 13px 15px;
            border-bottom: 1px solid #f0f1f4;
            color: #3c4658;
            font-size: .78rem;
            vertical-align: middle;
            white-space: nowrap;
        }

        #visitsTable tbody tr:last-child td {
            border-bottom: none;
        }

        #visitsTable tbody tr {
            transition: .15s;
        }

            #visitsTable tbody tr:hover {
                background: #fafbff;
            }

    .visitor-name {
        color: var(--primary);
        font-weight: 750;
    }

    .company-name {
        color: #596579;
    }

    .empty-value {
        color: #a0aec0;
    }

    /* =========================================================
           STATUS
        ========================================================= */

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 9px;
        border-radius: 20px;
        font-size: .66rem;
        font-weight: 800;
    }

        .status-badge::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
        }

    .status-inside {
        color: #137a40;
        background: var(--success-soft);
    }

        .status-inside::before {
            background: var(--success);
        }

    .status-out {
        color: #687386;
        background: #f0f2f5;
    }

        .status-out::before {
            background: #8892a5;
        }

    /* =========================================================
           ACTION BUTTONS
        ========================================================= */

    .actions-container {
        display: flex;
        align-items: center;
        gap: 4px;
        flex-wrap: nowrap;
    }

    .action-btn {
        border: none;
        min-height: 30px;
        padding: 5px 8px;
        border-radius: 7px;
        font-size: .65rem;
        font-weight: 700;
        white-space: nowrap;
        transition: .2s;
    }

    .action-view {
        color: #087ea4;
        background: var(--info-soft);
    }

        .action-view:hover {
            background: #d9f1fb;
        }

    .action-edit {
        color: #a96800;
        background: var(--warning-soft);
    }

        .action-edit:hover {
            background: #ffedc7;
        }

    .action-delete {
        color: #c82333;
        background: var(--danger-soft);
    }

        .action-delete:hover {
            background: #ffdce0;
        }

    .action-checkout {
        color: #14753e;
        background: var(--success-soft);
    }

        .action-checkout:hover {
            background: #d9f3e5;
        }

    .action-new {
        color: var(--primary);
        background: var(--primary-soft);
    }

    .action-history {
        color: #495057;
        background: #f1f3f5;
    }

    /* =========================================================
       ACTIONS DROPDOWN
    ========================================================= */

    .action-dropdown-btn {
        width: 36px;
        height: 36px;
        padding: 0;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: #fff;
        color: var(--primary);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: .2s;
    }

        .action-dropdown-btn:hover,
        .action-dropdown-btn:focus {
            background: var(--primary-soft);
            color: var(--primary);
            border-color: var(--primary);
            box-shadow: none;
        }

        /* Remove Bootstrap's default arrow */
        .action-dropdown-btn::after {
            display: none;
        }

        .action-dropdown-btn i {
            font-size: 1.1rem;
        }

    .action-dropdown-menu {
        min-width: 180px;
        padding: 6px;
        border: 1px solid var(--border);
        border-radius: 9px;
        box-shadow: 0 8px 25px rgba(0,0,0,.12);
    }

        .action-dropdown-menu .dropdown-item {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 9px 10px;
            border-radius: 7px;
            font-size: .78rem;
            font-weight: 600;
        }

            .action-dropdown-menu .dropdown-item i {
                width: 18px;
                font-size: .95rem;
            }

            .action-dropdown-menu .dropdown-item:hover {
                background: var(--primary-soft);
            }

            .action-dropdown-menu .dropdown-item.text-danger:hover {
                background: #fff1f1;
            }
    /* =========================================================
           PAGINATION
        ========================================================= */

    .pagination-wrapper {
        padding: 16px 20px;
        border-top: 1px solid var(--border);
    }

    .pagination {
        margin: 0;
    }

    .page-link {
        border: 1px solid var(--border);
        color: var(--primary);
        font-size: .73rem;
        font-weight: 700;
        min-width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .page-link:hover {
            background: var(--primary-soft);
            color: var(--primary);
        }

    .page-item.active .page-link {
        background: var(--primary);
        border-color: var(--primary);
    }

    /* =========================================================
           MODALS - COMPACT
        ========================================================= */

    .modal-backdrop.show {
        opacity: .45;
    }

    .modal-dialog {
        margin: 1rem auto;
    }

    /*
           Important:
           We intentionally DON'T use modal-lg for View/Edit.
           This prevents the modal from becoming almost full screen.
        */

    #viewModal .modal-dialog {
        max-width: 680px;
    }

    #editModal .modal-dialog {
        max-width: 720px;
    }

    #checkOutModal .modal-dialog,
    #deleteModal .modal-dialog {
        max-width: 430px;
    }

    .modal-content {
        border: none;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 20px 50px rgba(0,0,0,.18);
    }

    .modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: linear-gradient(135deg, var(--primary), var(--primary-light));
        color: #fff;
        border: none;
        padding: 13px 18px;
    }

        .modal-header .modal-title {
            color: #fff;
            font-size: .94rem;
            font-weight: 800;
            margin: 0;
        }

        .modal-header .btn-close {
            margin: 0 !important;
            padding: .5rem;
            filter: invert(1) brightness(2);
            opacity: .85;
            font-size: .75rem;
            flex-shrink: 0;
        }

    .modal-body {
        padding: 17px 18px;
    }

    .modal-footer {
        padding: 11px 18px;
        border-top: 1px solid var(--border);
        background: #fafbfc;
    }

        .modal-footer .btn {
            min-height: 36px;
            padding: 7px 14px;
            border-radius: 7px;
            font-size: .75rem;
            font-weight: 700;
        }

    /* =========================================================
           VIEW MODAL
        ========================================================= */

    .modal-section-title {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--primary);
        font-size: .78rem;
        font-weight: 800;
        padding-bottom: 8px;
        margin-bottom: 12px;
        border-bottom: 1px solid var(--border);
    }

        .modal-section-title::before {
            content: "";
            width: 3px;
            height: 15px;
            background: var(--primary);
            border-radius: 3px;
        }

    .details-item {
        margin-bottom: 10px;
        padding: 9px 11px;
        background: #f8f9fc;
        border: 1px solid #eef0f4;
        border-radius: 8px;
        min-height: 58px;
    }

    .details-label {
        display: block;
        color: var(--muted);
        font-size: .62rem;
        font-weight: 700;
        text-transform: uppercase;
        margin-bottom: 4px;
        letter-spacing: .2px;
    }

    .details-value {
        color: var(--text);
        font-size: .77rem;
        font-weight: 600;
        word-break: break-word;
    }

    /* =========================================================
           EDIT MODAL
        ========================================================= */

    #editModal .modal-body {
        max-height: 70vh;
        overflow-y: auto;
    }

    #editModal .row {
        --bs-gutter-x: 12px;
        --bs-gutter-y: 0;
    }

    #editModal .mb-3 {
        margin-bottom: 10px !important;
    }

    #editModal .form-label {
        color: var(--text);
        font-size: .69rem;
        font-weight: 700;
        margin-bottom: 5px;
    }

    #editModal .form-control,
    #editModal .form-select {
        min-height: 38px;
        font-size: .76rem;
        border-radius: 7px;
    }

    #editModal .form-check {
        padding-top: 3px;
        margin-bottom: 2px;
    }

    #editModal .form-check-label {
        font-size: .73rem;
        color: var(--text);
        font-weight: 600;
    }

    /* =========================================================
           EMPTY STATE
        ========================================================= */

    .empty-state {
        text-align: center;
        padding: 50px 20px;
        color: var(--muted);
    }

    .empty-icon {
        width: 52px;
        height: 52px;
        margin: 0 auto 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: var(--primary-soft);
        color: var(--primary);
        font-size: 21px;
    }

    .empty-state h5 {
        color: var(--text);
        font-weight: 800;
        margin-bottom: 5px;
    }

    .empty-state p {
        margin: 0;
        font-size: .78rem;
    }

    /* =========================================================
           RESPONSIVE
        ========================================================= */

    @@media (max-width: 1200px) {

        .filter-field {
            grid-column: span 4;
        }

        .filter-search {
            grid-column: span 8;
        }

        .filter-buttons {
            grid-column: span 4;
        }

        #visitsTable {
            min-width: 1000px;
        }
    }

    @@media (max-width: 992px) {

        .dashboard-container {
            padding: 18px;
        }

        .statistics-grid {
            gap: 12px;
        }

        .stat-card {
            padding: 15px;
        }

        .stat-value {
            font-size: 1.7rem;
        }

        .filter-field {
            grid-column: span 6;
        }

        .filter-search {
            grid-column: span 12;
        }

        .filter-buttons {
            grid-column: span 6;
        }

        #viewModal .modal-dialog,
        #editModal .modal-dialog {
            max-width: 90%;
        }
    }

    @@media (max-width: 768px) {

        .dashboard-container {
            padding: 14px;
        }

        .hero-topbar {
            padding: 12px 14px;
            margin-bottom: 18px;
        }

        .topbar-content {
            align-items: flex-start;
        }

        .system-icon {
            width: 36px;
            height: 36px;
        }

        .system-title {
            font-size: .86rem;
        }

        .system-subtitle {
            display: none;
        }

        .page-header {
            flex-direction: column;
            align-items: stretch;
        }

        .page-title {
            font-size: 1.45rem;
        }

        .add-visit-btn {
            width: 100%;
        }

        .statistics-grid {
            grid-template-columns: 1fr;
            gap: 10px;
        }

        .stat-card {
            min-height: 115px;
        }

        .filter-grid {
            grid-template-columns: 1fr;
            gap: 12px;
        }

        .filter-field,
        .filter-search,
        .filter-buttons {
            grid-column: span 1;
        }

        .filter-buttons {
            align-items: stretch;
        }

        .filter-btn {
            flex: 1;
        }

        .table-card-header {
            flex-direction: column;
            align-items: stretch;
        }

        .table-actions {
            width: 100%;
        }

        .export-btn {
            flex: 1;
        }

        .card-body-custom {
            padding: 12px;
        }

        .table-wrapper {
            margin: 0 -12px;
            width: calc(100% + 24px);
        }

        #visitsTable {
            min-width: 1050px;
        }

        .modal-dialog {
            margin: 8px;
        }

        #viewModal .modal-dialog,
        #editModal .modal-dialog {
            max-width: none;
        }

        #editModal .modal-body {
            max-height: 75vh;
        }

        .modal-body {
            padding: 14px;
        }

        .details-item {
            min-height: auto;
            margin-bottom: 8px;
        }
    }

    @@media (max-width: 480px) {

        .language-btn {
            padding: 5px 8px;
            font-size: .68rem;
        }

        .page-title {
            font-size: 1.3rem;
        }

        .page-subtitle {
            font-size: .76rem;
        }

        .stat-card {
            padding: 14px;
        }

        .stat-value {
            font-size: 1.5rem;
        }

        .card-header-custom,
        .table-card-header {
            padding: 14px;
        }

        .pagination-wrapper {
            padding: 13px;
            overflow-x: auto;
        }

        .pagination .page-link {
            min-width: 31px;
            height: 31px;
            font-size: .68rem;
        }
        /* =========================================================
       CHECKOUT MODAL ABOVE VIEW MODAL
    ========================================================= */

        #checkOutModal {
            z-index: 1060 !important;
        }
    }



</style>


