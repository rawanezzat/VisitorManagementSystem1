<!-- =========================================================
     JAVASCRIPT
========================================================= -->
<script>


    /* =========================================================
       EDIT FORM VALIDATION - National ID
    ========================================================= */

    function validateEditNationalId() {

        const hasIdCheckbox = document.getElementById("editHasId");
        const nationalIdInput = document.getElementById("editNationalId");
        const nationalIdError = document.getElementById("editNationalIdError");

        if (!hasIdCheckbox || !nationalIdInput || !nationalIdError) {
            return true; 
        }

        const isRequired = hasIdCheckbox.checked;
        const nationalId = (nationalIdInput.value || "").trim();

        nationalIdInput.required = isRequired;

        if (isRequired && nationalId === "") {
            nationalIdInput.classList.add("is-invalid");
            nationalIdError.style.display = "block";
            return false;
        }

        nationalIdInput.classList.remove("is-invalid");
        nationalIdError.style.display = "none";
        return true;
    }


    document.addEventListener("DOMContentLoaded", function () {

        const editForm = document.querySelector("#editModal form");
        const hasIdCheckbox = document.getElementById("editHasId");
        const nationalIdInput = document.getElementById("editNationalId");

        if (!editForm || !hasIdCheckbox || !nationalIdInput) {
            return;
        }

        hasIdCheckbox.addEventListener("change", function () {
            if (!hasIdCheckbox.checked) {
                nationalIdInput.classList.remove("is-invalid");
                const err = document.getElementById("editNationalIdError");
                if (err) err.style.display = "none";
                nationalIdInput.value = "";  
            }
            validateEditNationalId();
        });

        nationalIdInput.addEventListener("input", validateEditNationalId);
        nationalIdInput.addEventListener("blur", validateEditNationalId);

        editForm.addEventListener("submit", function (event) {
            if (!validateEditNationalId()) {
                event.preventDefault();
                event.stopPropagation();
                nationalIdInput.focus();
                return false;
            }
        });

        document.getElementById("editModal")?.addEventListener("shown.bs.modal", function () {
            validateEditNationalId();
        });
    });

    /* =========================================================
       GLOBAL
    ========================================================= */

    let returnToTodayVisits = false;

    let currentViewVisitId = null;
    let currentViewVisitorName = "";
    const currentLanguage =
        '@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName';

    const isArabic =
        currentLanguage === "ar";


    /* =========================================================
       TRANSLATIONS
    ========================================================= */

    const text = {

        view: isArabic
            ? "عرض"
            : "View",

        close: isArabic
            ? "إغلاق"
            : "Close",

        inside:
            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Localizer["Inside"].Value
                        )),

        checkedOut:
            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                Localizer["CheckedOut"].Value
                        )),

        interview:
            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                Localizer["Interview"].Value
                        )),

        training:
            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                Localizer["Training"].Value
                        )),

        delivery:
            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                Localizer["Delivery"].Value
                        )),

        meeting:
            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                Localizer["Meeting"].Value
                        )),

        other:
            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                Localizer["Other"].Value
                        )),

        stillInside:
            isArabic
                ? "ما زال بالداخل"
                : "Still Inside",

        none:
            isArabic
                ? "لا يوجد"
                : "None",

        loading:
            isArabic
                ? "جاري تحميل زيارات اليوم..."
                : "Loading today's visits...",

        noVisits:
            isArabic
                ? "لا توجد زيارات اليوم."
                : "No visits today.",

        loadingError:
            isArabic
                ? "حدث خطأ أثناء تحميل زيارات اليوم."
                : "Failed to load today's visits.",

        visitError:
            isArabic
                ? "حدث خطأ أثناء تحميل بيانات الزيارة."
                : "Could not load visit information."
    };


    /* =========================================================
       HELPER
    ========================================================= */

    function getElement(id) {

        return document.getElementById(id);

    }


    /* =========================================================
       TRANSLATE VISIT TYPE
    ========================================================= */

    function translateVisitType(type, otherVisitType) {

        if (!type) {
            return "-";
        }

        type = type.trim();

        switch (type) {

            case "Interview":
                return text.interview;

            case "Training":
                return text.training;

            case "Delivery":
                return text.delivery;

            case "Meeting":
                return text.meeting;

            case "Other":
                return otherVisitType || text.other;

            default:
                return type;
        }
    }


    /* =========================================================
       TRANSLATE STATUS
    ========================================================= */

    function translateStatus(status) {

        if (!status) {
            return "-";
        }

        status = status.trim();

        if (status === "Inside") {
            return text.inside;
        }

        if (status === "Checked Out") {
            return text.checkedOut;
        }

        return status;
    }


    /* =========================================================
       CHECKOUT MODAL
    ========================================================= */

    function openCheckOutModal(id, visitorName) {

        const nameElement =
            getElement("visitorName");

        const confirmButton =
            getElement("confirmCheckOut");

        const modalElement =
            getElement("checkOutModal");


        if (!modalElement) {

            console.error(
                "checkOutModal not found."
            );

            return;
        }


        if (nameElement) {

            nameElement.innerText =
                visitorName || "-";
        }


        if (confirmButton) {

            confirmButton.href =
                "/Dashboard/CheckOut?id=" + id;
        }


        const modal =
            bootstrap.Modal.getOrCreateInstance(
                modalElement
            );

        modal.show();
    }

    function checkoutFromViewModal() {

        if (!currentViewVisitId) {

            console.error("No visit ID found.");

            return;
        }

        openCheckOutModal(
            currentViewVisitId,
            currentViewVisitorName
        );

        // Make Checkout Modal appear above View Modal
        setTimeout(function () {

            const checkoutModal =
                document.getElementById("checkOutModal");

            if (checkoutModal) {
                checkoutModal.style.zIndex = "1060";
            }

            // Get the latest backdrop
            const backdrops =
                document.querySelectorAll(".modal-backdrop");

            if (backdrops.length > 0) {

                const latestBackdrop =
                    backdrops[backdrops.length - 1];

                latestBackdrop.style.zIndex = "1059";
            }

        }, 50);
    }    /* =========================================================
       VIEW VISIT MODAL
    ========================================================= */

    function openViewModal(id) {

        console.log(
            "Opening visit:",
            id
        );


        fetch(
            "/Dashboard/GetVisit?id=" +
            encodeURIComponent(id),
            {
                method: "GET",
                headers: {
                    "Accept": "application/json"
                }
            }
        )

        .then(function (response) {

            console.log(
                "GetVisit status:",
                response.status
            );


            if (!response.ok) {

                throw new Error(
                    "HTTP Error: " +
                    response.status
                );
            }


            return response.json();

        })


        .then(function (data) {

            console.log(
                "Visit data:",
                data
            );


            /*
             * IMPORTANT:
             * Your controller returns fullName.
             * We also support visitorName just in case.
             */
    const fullName =
        data.fullName ||
        data.visitorName ||
        "-";

    currentViewVisitId = data.id || id;
    currentViewVisitorName = fullName;

            /* =========================
               VISITOR
            ========================= */

            const viewName =
                getElement("viewName");

            if (viewName) {

                viewName.innerText =
                    fullName;
            }


            const viewPhone =
                getElement("viewPhone");

            if (viewPhone) {

                viewPhone.innerText =
                    data.phone || "-";
            }


            const viewEmail =
                getElement("viewEmail");

            if (viewEmail) {

                viewEmail.innerText =
                    data.email || "-";
            }


            /* =========================
               VISIT
            ========================= */

            const viewCompany =
                getElement("viewCompany");

            if (viewCompany) {

                viewCompany.innerText =
                    data.companyName || "-";
            }


            const viewEmployee =
                getElement("viewEmployeeToMeet");

            if (viewEmployee) {

                viewEmployee.innerText =
                    data.employeeToMeet || "-";
            }


            const viewDepartment =
                getElement("viewDepartment");

            if (viewDepartment) {

                viewDepartment.innerText =
                    data.department || "-";
            }


            const viewReceptionist =
                getElement("viewReceptionist");

            if (viewReceptionist) {

                viewReceptionist.innerText =
                    data.receptionist || "-";
            }


            /* =========================
               VISIT TYPE
            ========================= */

            const viewVisitType =
                getElement("viewVisitType");

            if (viewVisitType) {

                viewVisitType.innerText =
                    translateVisitType(
                        data.visitType,
                        data.otherVisitType
                    );
            }


            /* =========================
               STATUS
            ========================= */

            const viewStatus =
                getElement("viewStatus");

            if (viewStatus) {

                viewStatus.innerText =
                    translateStatus(
                        data.status
                    );
            }

                const viewCheckOutButton =
        getElement("viewCheckOutButton");

    if (viewCheckOutButton) {

        if (data.status === "Inside") {

            viewCheckOutButton.style.display =
                "inline-block";

        }
        else {

            viewCheckOutButton.style.display =
                "none";
        }
    }


            /* =========================
               ITEMS
            ========================= */

            const viewItemName =
                getElement("viewItemName");

            if (viewItemName) {

                viewItemName.innerText =
                    data.itemName ||
                    text.none;
            }


            const viewQuantity =
                getElement("viewQuantity");

            if (viewQuantity) {

                viewQuantity.innerText =
                    data.quantity ||
                    "0";
            }


            /* =========================
               TIME
            ========================= */

            const viewCheckIn =
                getElement("viewCheckIn");

            if (viewCheckIn) {

                viewCheckIn.innerText =
                    data.checkIn || "-";
            }


            const viewCheckOut =
                getElement("viewCheckOut");

            if (viewCheckOut) {

                viewCheckOut.innerText =
                    data.checkOut || "-";
            }


            /* =========================
               DURATION
            ========================= */

            const viewDuration =
                getElement("viewDuration");

            if (viewDuration) {

                if (
                    data.duration ===
                    "Still Inside"
                ) {

                    viewDuration.innerText =
                        text.stillInside;

                }
                else {

                    viewDuration.innerText =
                        data.duration || "-";
                }
            }


            /* =================================================
               TODAY MODAL IS OPEN?
            ================================================= */

            const todayModalElement =
                getElement(
                    "todayVisitsModal"
                );


            const viewModalElement =
                getElement(
                    "viewModal"
                );


            if (!viewModalElement) {

                console.error(
                    "viewModal was not found."
                );

                return;
            }


            /*
             * If View was clicked from Today's Visits,
             * close Today's Visits first.
             */

            if (
                todayModalElement &&
                todayModalElement.classList.contains("show")
            ) {

                returnToTodayVisits =
                    true;


                const todayModal =
                    bootstrap.Modal
                        .getOrCreateInstance(
                            todayModalElement
                        );


                todayModalElement.addEventListener(
                    "hidden.bs.modal",
                    function openViewAfterToday() {

                        todayModalElement.removeEventListener(
                            "hidden.bs.modal",
                            openViewAfterToday
                        );


                        const viewModal =
                            bootstrap.Modal
                                .getOrCreateInstance(
                                    viewModalElement
                                );

                        viewModal.show();

                    }
                );


                todayModal.hide();

            }
            else {

                returnToTodayVisits =
                    false;


                const viewModal =
                    bootstrap.Modal
                        .getOrCreateInstance(
                            viewModalElement
                        );

                viewModal.show();
            }

        })


        .catch(function (error) {

            console.error(
                "GetVisit Error:",
                error
            );


            alert(
                text.visitError
            );

        });
    }


    /* =========================================================
       WHEN VIEW MODAL CLOSES
       RETURN TO TODAY'S VISITS
    ========================================================= */

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            const viewModalElement =
                getElement("viewModal");


            if (!viewModalElement) {
                return;
            }


            viewModalElement.addEventListener(
                "hidden.bs.modal",
                function () {

                    if (!returnToTodayVisits) {
                        return;
                    }


                    returnToTodayVisits =
                        false;


                    setTimeout(
                        function () {

                            const todayModalElement =
                                getElement(
                                    "todayVisitsModal"
                                );


                            if (!todayModalElement) {
                                return;
                            }


                            const todayModal =
                                bootstrap.Modal
                                    .getOrCreateInstance(
                                        todayModalElement
                                    );


                            todayModal.show();


                            loadTodayVisits();

                        },
                        250
                    );
                }
            );

        }
    );


    /* =========================================================
       DELETE MODAL
    ========================================================= */

    function openDeleteModal(
        id,
        visitorName
    ) {

        const nameElement =
            getElement(
                "deleteVisitorName"
            );


        const confirmButton =
            getElement(
                "confirmDelete"
            );


        const modalElement =
            getElement(
                "deleteModal"
            );


        if (nameElement) {

            nameElement.innerText =
                visitorName || "-";
        }


        if (confirmButton) {

            confirmButton.href =
                "/Dashboard/Delete?id=" +
                id;
        }


        if (!modalElement) {

            console.error(
                "deleteModal not found."
            );

            return;
        }


        const modal =
            bootstrap.Modal.getOrCreateInstance(
                modalElement
            );


        modal.show();
    }


    /* =========================================================
       EDIT MODAL
    ========================================================= */
    function openEditModal(id) {

        fetch(
            "/Dashboard/GetVisit?id=" + encodeURIComponent(id),
            {
                method: "GET",
                headers: {
                    "Accept": "application/json"
                }
            }
        )
        .then(function (response) {

            if (!response.ok) {
                throw new Error("Failed to get visit.");
            }

            return response.json();
        })
        .then(function (data) {

            console.log("Edit Visit Data:", data);

            // ==========================================
            // Visit ID
            // ==========================================

            const visitId = getElement("editVisitId");

            if (visitId) {
                visitId.value = data.id ?? "";
            }


            // ==========================================
            // Visitor
            // ==========================================

            const fullName = getElement("editFullName");

            if (fullName) {
                fullName.value =
                    data.fullName ??
                    data.visitorName ??
                    "";
            }


            const phone = getElement("editPhone");

            if (phone) {
                phone.value = data.phone ?? "";
            }


            const email = getElement("editEmail");

            if (email) {
                email.value = data.email ?? "";
            }


            // ==========================================
            // Visit Information
            // ==========================================

            const company = getElement("editCompany");

            if (company) {
                company.value = data.companyName ?? "";
            }


            const employee = getElement("editEmployeeToMeet");

            if (employee) {
                employee.value = data.employeeToMeet ?? "";
            }


            const department = getElement("editDepartment");

            if (department) {
                department.value = data.department ?? "";
            }


            // ==========================================
            // Visit Type
            // ==========================================

            const visitType = getElement("editVisitType");

            if (visitType) {

                visitType.value =
                    data.visitTypeId != null
                        ? String(data.visitTypeId)
                        : "";
            }


            // ==========================================
            // Other Visit Type
            // ==========================================

            const otherVisitType =
                getElement("editOtherVisitType");

            if (otherVisitType) {
                otherVisitType.value =
                    data.otherVisitType ?? "";
            }


            // ==========================================
            // Receptionist
            // ==========================================

            const receptionist =
                getElement("editReceptionist");

            if (receptionist) {

                receptionist.value =
                    data.receptionistId != null
                        ? String(data.receptionistId)
                        : "";
            }


            // ==========================================
            // National ID
            // ==========================================

            const nationalId =
                getElement("editNationalId");

            if (nationalId) {
                nationalId.value =
                    data.nationalId ?? "";
            }


            // ==========================================
            // Has ID
            // ==========================================

            const hasId =
                getElement("editHasId");

            if (hasId) {
                hasId.checked =
                    data.hasId === true;
            }


            // ==========================================
            // Open Modal
            // ==========================================

            const modalElement =
                getElement("editModal");

            if (!modalElement) {

                console.error(
                    "editModal not found."
                );

                return;
            }


            const modal =
                bootstrap.Modal.getOrCreateInstance(
                    modalElement
                );

            modal.show();

        })
        .catch(function (error) {

            console.error(
                "Edit Visit Error:",
                error
            );

            alert(text.visitError);
        });
    }
    /* =========================================================
       DATE FILTER
    ========================================================= */

    function toggleDateInputs() {

        const periodElement =
            getElement("period");


        if (!periodElement) {
            return;
        }


        const fromContainer =
            getElement(
                "fromDateContainer"
            );


        const toContainer =
            getElement(
                "toDateContainer"
            );


        if (
            !fromContainer ||
            !toContainer
        ) {
            return;
        }


        if (
            periodElement.value ===
            "Custom"
        ) {

            fromContainer.style.display =
                "block";

            toContainer.style.display =
                "block";

        }
        else {

            fromContainer.style.display =
                "none";

            toContainer.style.display =
                "none";
        }
    }


    /* =========================================================
       OPEN TODAY VISITS MODAL
    ========================================================= */

    function openTodayVisitsModal() {

        console.log(
            "Opening Today's Visits..."
        );


        const modalElement =
            getElement(
                "todayVisitsModal"
            );


        if (!modalElement) {

            console.error(
                "todayVisitsModal was not found."
            );

            return;
        }


        const modal =
            bootstrap.Modal.getOrCreateInstance(
                modalElement
            );


        modal.show();


        /*
         * Load after opening
         */
        loadTodayVisits();
    }


    /* =========================================================
       LOAD TODAY VISITS
    ========================================================= */

    function loadTodayVisits() {

        console.log(
            "Loading Today's Visits..."
        );


        const loading =
            getElement(
                "todayVisitsLoading"
            );


        const empty =
            getElement(
                "todayVisitsEmpty"
            );


        const container =
            getElement(
                "todayVisitsTableContainer"
            );


        const tbody =
            getElement(
                "todayVisitsBody"
            );


        if (
            !loading ||
            !empty ||
            !container ||
            !tbody
        ) {

            console.error(
                "Today's Visits HTML elements are missing."
            );

            return;
        }


        /* =========================
           RESET
        ========================= */

        loading.style.display =
            "block";

        empty.style.display =
            "none";

        container.style.display =
            "none";

        tbody.innerHTML =
            "";


        /* =========================
           API REQUEST
        ========================= */

        fetch(
            "/Dashboard/GetTodayVisits",
            {
                method: "GET",

                headers: {
                    "Accept":
                        "application/json"
                },

                cache: "no-store"
            }
        )


        .then(function (response) {

            console.log(
                "GetTodayVisits status:",
                response.status
            );


            if (!response.ok) {

                throw new Error(
                    "HTTP Error " +
                    response.status
                );
            }


            return response.json();

        })


        .then(function (result) {

            console.log(
                "GetTodayVisits result:",
                result
            );


            loading.style.display =
                "none";


            /*
             * Support both:
             *
             * [...]
             *
             * and:
             *
             * { data: [...] }
             */

            let visits = result;


            if (
                result &&
                !Array.isArray(result) &&
                Array.isArray(result.data)
            ) {

                visits =
                    result.data;
            }


            /* =========================
               EMPTY
            ========================= */

            if (
                !Array.isArray(visits) ||
                visits.length === 0
            ) {

                container.style.display =
                    "none";

                empty.style.display =
                    "block";

                empty.innerHTML = `
                    <div class="py-4 text-muted">
                        ${text.noVisits}
                    </div>
                `;

                return;
            }


            /* =========================
               SHOW TABLE
            ========================= */

            empty.style.display =
                "none";

            container.style.display =
                "block";


            /* =========================
               CREATE ROWS
            ========================= */

            visits.forEach(
                function (visit) {

                    const row =
                        document.createElement(
                            "tr"
                        );


                    /* =====================
                       VISITOR
                    ===================== */

                    const visitorName =
                        visit.visitorName ||
                        visit.fullName ||
                        "-";


                    /* =====================
                       STATUS
                    ===================== */

                    const originalStatus =
                        visit.status || "";


                    const statusText =
                        translateStatus(
                            originalStatus
                        );


                    let statusBadge = "";


                    if (
                        originalStatus ===
                        "Inside"
                    ) {

                        statusBadge = `
                            <span class="badge bg-success">
                                ${statusText}
                            </span>
                        `;

                    }
                    else {

                        statusBadge = `
                            <span class="badge bg-secondary">
                                ${statusText || "-"}
                            </span>
                        `;
                    }


                    /* =====================
                       VISIT TYPE
                    ===================== */

                    const visitTypeText =
                        translateVisitType(
                            visit.visitType,
                            visit.otherVisitType
                        );


                    /* =====================
                       ROW
                    ===================== */

                    row.innerHTML = `

                        <td>
                            <strong>
                                ${visitorName}
                            </strong>
                        </td>


                        <td>
                            ${visit.phone || "-"}
                        </td>


                        <td>
                            ${visit.company || "-"}
                        </td>


                        <td>
                            ${visit.employeeToMeet || "-"}
                        </td>


                        <td>
                            ${visitTypeText}
                        </td>


                        <td>
                            ${visit.receptionist || "-"}
                        </td>


                        <td>
                            ${statusBadge}
                        </td>


                        <td>
                            ${visit.checkIn || "-"}
                        </td>


                        <td>
                            ${visit.checkOut || "-"}
                        </td>


                        <td>

                                <button
        type="button"
        class="btn btn-sm "
        onclick="openViewModal(${visit.id})"
        title="${text.view}"
        aria-label="${text.view}">

        <i class="bi bi-eye"></i>
    </button>

                        </td>

                    `;


                    tbody.appendChild(
                        row
                    );

                }
            );

        })


        .catch(function (error) {

            console.error(
                "Today's Visits Error:",
                error
            );


            loading.style.display =
                "none";

            container.style.display =
                "none";

            empty.style.display =
                "block";


            empty.innerHTML = `

                <div class="text-danger py-4">

                    ${text.loadingError}

                </div>

            `;

        });
    }


    /* =========================================================
       DOM READY
    ========================================================= */

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            console.log(
                "Dashboard JavaScript loaded."
            );


            /* =========================
               DATE FILTER
            ========================= */

            const period =
                getElement("period");


            if (period) {

                period.addEventListener(
                    "change",
                    toggleDateInputs
                );

                toggleDateInputs();
            }


            /* =========================
               TODAY MODAL
            ========================= */

            const todayModal =
                getElement(
                    "todayVisitsModal"
                );


            if (todayModal) {

                todayModal.addEventListener(
                    "shown.bs.modal",
                    function () {

                        console.log(
                            "Today's Visits modal opened."
                        );


                        loadTodayVisits();

                    }
                );
            }

        }
    );

</script>
           
                

