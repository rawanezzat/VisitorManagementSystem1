    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <div class="page-header">

        <div>


            <h1 class="page-title">
                @Localizer["VisitorManagement"]
            </h1>

            <p class="page-subtitle">
                @Localizer["AllVisits"]
            </p>

        </div>

        <a asp-controller="Visits"
           asp-action="Create"
           class="add-visit-btn">

            <span>+</span>

            @Localizer["AddNewVisit"]

        </a>

    </div>


    <!-- =====================================================
         STATISTICS
    ====================================================== -->

    <div class="statistics-grid">

        <div class="stat-card">

            <div class="stat-content">

                <div class="stat-top">

                    <span class="stat-label">
                        @Localizer["TotalVisitsToday"]
                    </span>

                    <div class="stat-icon">
                        #
                    </div>

                </div>

                <h2 class="stat-value">
                    @Model.TotalVisitsToday
                </h2>

                <div class="stat-label">
                    @Localizer["VisitorsRegisteredToday"]
                </div>

                <!-- View Today Visits -->
                <button type="button"
                        class="btn btn-sm filter-btn-primary mt-3"
                        data-bs-toggle="modal"
                        data-bs-target="#todayVisitsModal">

                    @Localizer["ViewToday'sVisits"]

                </button>

            </div>

        </div>

        <div class="stat-card inside">

            <div class="stat-content">

                <div class="stat-top">

                    <span class="stat-label">
                        @Localizer["CurrentlyInside"]
                    </span>

                    <div class="stat-icon">
                        ●
                    </div>

                </div>

                <h2 class="stat-value">
                    @Model.CurrentlyInside
                </h2>

                <span class="stat-label">
                    @Localizer["VisitorsCurrentlyInside"]
                </span>

            </div>

        </div>


        <div class="stat-card checked">

            <div class="stat-content">

                <div class="stat-top">

                    <span class="stat-label">
                        @Localizer["CheckedOut"]
                    </span>

                    <div class="stat-icon">
                        ✓
                    </div>

                </div>

                <h2 class="stat-value">
                    @Model.CheckedOutToday
                </h2>

                <span class="stat-label">
                    @Localizer["VisitorsCheckedOutToday"]
                </span>

            </div>

        </div>

    </div>


    <!-- =====================================================
         FILTERS
    ====================================================== -->

    <div class="dashboard-card">

        <div class="card-header-custom">

            <div>

                <h3 class="card-title-custom">
                    @Localizer["Search"]
                </h3>

                

            </div>

        </div>

        <div class="card-body-custom">

            <form asp-controller="Dashboard"
                  asp-action="Index"
                  method="get">

                <div class="filter-grid">

                    <!-- Period -->

                    <div class="filter-field">

                        <label>
                            @Localizer["Period"]
                        </label>

                        <select name="period"
                                id="period"
                                class="form-select">

                            <option value="All"
                                    selected="@(Model.Period == "All")">
                                @Localizer["AllPeriods"]
                            </option>

                            <option value="Today"
                                    selected="@(Model.Period == "Today")">
                                @Localizer["Today"]
                            </option>

                            <option value="Week"
                                    selected="@(Model.Period == "Week")">
                                @Localizer["ThisWeek"]
                            </option>

                            <option value="Month"
                                    selected="@(Model.Period == "Month")">
                                @Localizer["ThisMonth"]
                            </option>

                            <option value="Custom"
                                    selected="@(Model.Period == "Custom")">
                                @Localizer["CustomRange"]
                            </option>

                        </select>

                    </div>


                    <!-- From -->

                    <div class="filter-field"
                         id="fromDateContainer">

                        <label>
                            @Localizer["From"]
                        </label>

                        <input type="date"
                               name="fromDate"
                               value="@(Model.FromDate?.ToString("yyyy-MM-dd"))"
                               class="form-control" />

                    </div>


                    <!-- To -->

                    <div class="filter-field"
                         id="toDateContainer">

                        <label>
                            @Localizer["To"]
                        </label>

                        <input type="date"
                               name="toDate"
                               value="@(Model.ToDate?.ToString("yyyy-MM-dd"))"
                               class="form-control" />

                    </div>


                    <!-- Status -->

                    <div class="filter-field">

                        <label>
                            @Localizer["Status"]
                        </label>

                        <select name="status"
                                class="form-select">

                            <option value="">
                                @Localizer["AllStatus"]
                            </option>

                            <option value="Inside"
                                    selected="@(Model.Status == "Inside")">
                                @Localizer["Inside"]
                            </option>

                            <option value="Checked Out"
                                    selected="@(Model.Status == "Checked Out")">
                                @Localizer["CheckedOut"]
                            </option>

                        </select>

                    </div>


                    <!-- Visit Type -->

                    <div class="filter-field">

                        <label>
                            @Localizer["VisitType"]
                        </label>

                        <select name="visitTypeId"
                                class="form-select">

                            <option value="">
                                @Localizer["AllVisitTypes"]
                            </option>

                            @foreach (var type in Model.VisitTypes)
                            {
                                <option value="@type.Id"
                                        selected="@(Model.VisitTypeId == type.Id)">

                                    @(System.Globalization.CultureInfo.CurrentUICulture.Name == "ar"
                                                                    ? type.NameAr
                                                                    : type.NameEn)

                            </option>
                                                        }

                        </select>

                    </div>


                    <!-- Search -->

                    <div class="filter-search">

                        <label>
                            @Localizer["Search"]
                        </label>

                        <input type="text"
                               name="search"
                               value="@Model.Search"
                               class="form-control"
                               placeholder="@Localizer["SearchVisitor"]" />

                    </div>


                    <!-- Buttons -->

                    <div class="filter-buttons">

                        <button type="submit"
                                class="filter-btn filter-btn-primary">

                            @Localizer["Filter"]

                        </button>

                        <a asp-controller="Dashboard"
                           asp-action="Index"
                           class="filter-btn filter-btn-reset text-center text-decoration-none">

                            @Localizer["Reset"]

                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- =====================================================
         VISITS TABLE
    ====================================================== -->

    <div class="dashboard-card">

        <div class="table-card-header">

            <div>

                <h3 class="card-title-custom">
                    @Localizer["AllVisits"]
                </h3>

                

            </div>

            <div class="table-actions">

                <a asp-controller="Dashboard"
                   asp-action="ExportExcel"
                   asp-route-period="@Model.Period"
                   asp-route-fromDate="@Model.FromDate"
                   asp-route-toDate="@Model.ToDate"
                   asp-route-status="@Model.Status"
                   asp-route-visitTypeId="@Model.VisitTypeId"
                   asp-route-search="@Model.Search"
                   class="export-btn">

                    Excel

                </a>

                <a asp-controller="Dashboard"
                   asp-action="ExportPdf"
                   asp-route-period="@Model.Period"
                   asp-route-fromDate="@Model.FromDate"
                   asp-route-toDate="@Model.ToDate"
                   asp-route-status="@Model.Status"
                   asp-route-visitTypeId="@Model.VisitTypeId"
                   asp-route-search="@Model.Search"
                   class="export-btn">

                    PDF

                </a>

            </div>

        </div>


        <div class="card-body-custom">

            @if (Model.Visits != null && Model.Visits.Any())
            {

                <div class="table-wrapper">

                    <table class="table"
                           id="visitsTable">

                        <thead>

                            <tr>

                                <th>@Localizer["VisitorName"]</th>
                                <th>@Localizer["Company"]</th>
                                <th>@Localizer["VisitType"]</th>
                                <th>@Localizer["Receptionist"]</th>
                                <th>@Localizer["Status"]</th>
                                <th>@Localizer["CheckIn"]</th>
                                <th>@Localizer["CheckOut"]</th>
                                <th>@Localizer["Actions"]</th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var visit in Model.Visits)
                            {

                                <tr>

                                    <!-- Visitor -->

                                    <td>

                                        <span class="visitor-name">
                                            @visit.Visitor.FullName
                                        </span>

                                    </td>


                                    <!-- Company -->

                                    <td>

                                        @if (string.IsNullOrEmpty(visit.CompanyName))
                                        {
                                            <span class="empty-value">-</span>
                                        }
                                        else
                                        {
                                            <span class="company-name">
                                                @visit.CompanyName
                                            </span>
                                        }

                                    </td>


                                    <!-- Visit Type -->

                                    <td>

                                        @if (visit.VisitType.NameEn == "Other")
                                        {
                                            @visit.OtherVisitType
                                        }
                                        else
                                        {
                                            @(System.Globalization.CultureInfo.CurrentUICulture.Name == "ar"
                                                                            ? visit.VisitType.NameAr
                                                                            : visit.VisitType.NameEn)
                                                                }

                                    </td>


                                    <!-- Receptionist -->

                                    <td>
                                        @visit.Receptionist.Name
                                    </td>


                                    <!-- Status -->

                                    <td>

                                        @if (visit.Status == "Inside")
                                        {

                                            <span class="status-badge status-inside">
                                                @Localizer["Inside"]
                                            </span>

                                        }
                                        else
                                        {

                                            <span class="status-badge status-out">
                                                @Localizer["CheckedOut"]
                                            </span>

                                        }

                                </td>


                                <!-- Check In -->

                                <td>
                                    @visit.CheckInTime.ToString("hh:mm tt")
                                </td>


                                <!-- Check Out -->

                                <td>

                                    @(visit.CheckOutTime.HasValue
                                                                    ? visit.CheckOutTime.Value.ToString("hh:mm tt")
                                                                    : "-")

                            </td>


                                    <!-- Actions -->

                                    <td>
                                        <div class="dropdown">
                                            <button type="button"
                                                    class="action-dropdown-btn"
                                                    data-bs-toggle="dropdown"
                                                    aria-expanded="false"
                                                    title="${isArabic ? 'الإجراءات' : 'Actions'}">

                                                <i class="bi bi-three-dots-vertical"></i>

                                            </button>

                                            <ul class="dropdown-menu action-dropdown-menu dropdown-menu-end">

                                                <!-- Add New Visit -->
                                                <li>
                                            @if (visit.Status == "Checked Out")
                                                    {

                                                        <a asp-controller="Visits"
                                                           asp-action="Create"
                                                           asp-route-visitorId="@visit.VisitorId"
                                                           class="dropdown-item">

                                                            + @Localizer["NewVisit"]

                                                        </a>

                                                    }
                                                </li>

                                                <!-- History -->
                                                <li>
                                            @if (!string.IsNullOrEmpty(visit.Visitor.Phone) &&
                                                                                        Model.PhonesWithHistory.Contains(visit.Visitor.Phone))
                                                    {

                                                        <a asp-controller="Dashboard"
                                                           asp-action="VisitorHistory"
                                                           asp-route-phone="@visit.Visitor.Phone"
                                                           class="dropdown-item">

                                                            <i class="bi bi-clock-history"></i>


                                                            @Localizer["History"]

                                                        </a>

                                                    }
                                                </li>

                                                @* <li>
                                                    <hr class="dropdown-divider">
                                                </li> *@

                                                <!-- View -->
                                                <li>
                                                    <button type="button"
                                                            class="dropdown-item"
                                                            onclick="openViewModal(@visit.Id)">
                                                        <i class="bi bi-eye"></i>
                                                        <span>
                                                            @Localizer["View"]
                                                        </span>

                                                    </button>
                                                </li>

                                                <!-- Edit -->
                                                <li>
                                                    <button type="button"
                                                            class="dropdown-item"
                                                            onclick="openEditModal(@visit.Id)">
                                                        <i class="bi bi-pencil"></i>
                                                        <span>
                                                            @Localizer["Edit"]
                                                        </span>

                                                    </button>
                                                </li>

                                                <!-- Delete -->
                                                <li>
                                                    <button type="button"
                                                            class="dropdown-item text-danger"
                                                            onclick="openDeleteModal(
                                                                    @visit.Id,
                                                                    '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(visit.Visitor.FullName))'
                                                                )">
                                                        <i class="bi bi-trash"></i>
                                                        <span>

@Localizer["Delete"]                                                        </span>

                                                    </button>
                                                </li>

                                            </ul>
                                        </div>
                                    </td>
                                </tr>

                            }

                        </tbody>

                    </table>

                </div>


                <!-- =================================================
                     PAGINATION
                ================================================== -->
                @if (Model.TotalPages > 1)
                {

                    <div class="pagination-wrapper">

                        <nav>

                            <ul class="pagination justify-content-center">

                                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">

                                    <a class="page-link"
                                       asp-controller="Dashboard"
                                       asp-action="Index"
                                       asp-route-period="@Model.Period"
                                       asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                                       asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                                       asp-route-status="@Model.Status"
                                       asp-route-visitTypeId="@Model.VisitTypeId"
                                       asp-route-search="@Model.Search"
                                       asp-route-page="@(Model.CurrentPage - 1)">

                                        ‹

                                    </a>

                                </li>


                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {

                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">

                                        <a class="page-link"
                                           asp-controller="Dashboard"
                                           asp-action="Index"
                                           asp-route-period="@Model.Period"
                                           asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                                           asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                                           asp-route-status="@Model.Status"
                                           asp-route-visitTypeId="@Model.VisitTypeId"
                                           asp-route-search="@Model.Search"
                                           asp-route-page="@i">

                                            @i

                                        </a>

                                    </li>

                                }


                                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">

                                    <a class="page-link"
                                       asp-controller="Dashboard"
                                       asp-action="Index"
                                       asp-route-period="@Model.Period"
                                       asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                                       asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                                       asp-route-status="@Model.Status"
                                       asp-route-visitTypeId="@Model.VisitTypeId"
                                       asp-route-search="@Model.Search"
                                       asp-route-page="@(Model.CurrentPage + 1)">

                                        ›

                                    </a>

                                </li>

                            </ul>

                        </nav>

                    </div>

                }

            }
            else
            {

                <div class="empty-state">

                    <div class="empty-icon">
                        ✓
                    </div>

                    <h5>
                        No visits found
                    </h5>

                    <p>
                        Try changing your filters or add a new visit.
                    </p>

                </div>

            }

        </div>

    </div>

</div>


<!-- =========================================================
     CHECKOUT MODAL
========================================================= -->

<div class="modal fade"
     id="checkOutModal"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    @Localizer["CheckOutVisitor"]
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <p class="mb-0"
                   style="font-size:.82rem; color:#4a5568;">

                    @Localizer["ConfirmCheckOut"]

                    <strong id="visitorName"></strong>?

                </p>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-light"
                        data-bs-dismiss="modal">

                    @Localizer["Cancel"]

                </button>

                <a id="confirmCheckOut"
                   class="btn btn-success">

                    @Localizer["CheckOut"]

                </a>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     VIEW MODAL
========================================================= -->

<div class="modal fade"
     id="viewModal"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    @Localizer["VisitDetails"]
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <!-- Visitor Information -->

                <h6 class="modal-section-title">
                    @Localizer["VisitorInformation"]
                </h6>

                <div class="row">

                    <div class="col-md-6">
                        <div class="details-item">
                            <span class="details-label">
                                @Localizer["VisitorName"]
                            </span>

                            <span id="viewName"
                                  class="details-value">
                            </span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="details-item">
                            <span class="details-label">
                                @Localizer["Phone"]
                            </span>

                            <span id="viewPhone"
                                  class="details-value">
                            </span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="details-item">
                            <span class="details-label">
                                @Localizer["Email"]
                            </span>

                            <span id="viewEmail"
                                  class="details-value">
                            </span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="details-item">
                            <span class="details-label">
                                @Localizer["Company"]
                            </span>

                            <span id="viewCompany"
                                  class="details-value">
                            </span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="details-item">
                            <span class="details-label">
                                @Localizer["EmployeeToMeet"]
                            </span>

                            <span id="viewEmployeeToMeet"
                                  class="details-value">
                            </span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="details-item">
                            <span class="details-label">
                                @Localizer["Department"]
                            </span>

                            <span id="viewDepartment"
                                  class="details-value">
                            </span>
                        </div>
                    </div>

                </div>


                <!-- Visit Information -->

                <h6 class="modal-section-title mt-3">
                    @Localizer["VisitInformation"]
                </h6>

