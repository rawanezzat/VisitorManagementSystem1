<script>

    function viewVisit(id) {

        fetch('/Dashboard/GetVisit?id=' + id)

            .then(response => {

                if (!response.ok) {

                    throw new Error(
                        "Failed to load visit."
                    );

                }

                return response.json();

            })

            .then(data => {


                document.getElementById(
                    "viewVisitorName"
                ).innerText =
                    data.visitorName ||
                    data.fullName ||
                    "-";


                document.getElementById(
                    "viewPhone"
                ).innerText =
                    data.phone || "-";


                document.getElementById(
                    "viewEmail"
                ).innerText =
                    data.email || "-";


                document.getElementById(
                    "viewCompany"
                ).innerText =
                    data.companyName || "-";


                document.getElementById(
                    "viewEmployee"
                ).innerText =
                    data.employeeToMeet || "-";


                document.getElementById(
                    "viewDepartment"
                ).innerText =
                    data.department || "-";


                document.getElementById(
                    "viewVisitType"
                ).innerText =
                    data.visitType || "-";


                document.getElementById(
                    "viewReceptionist"
                ).innerText =
                    data.receptionist || "-";


                document.getElementById(
                    "viewStatus"
                ).innerText =
                    data.status || "-";


                document.getElementById(
                    "viewCheckIn"
                ).innerText =
                    data.checkIn || "-";


                document.getElementById(
                    "viewCheckOut"
                ).innerText =
                    data.checkOut || "-";


                document.getElementById(
                    "viewDuration"
                ).innerText =
                    data.duration || "-";


                var modalElement =
                    document.getElementById(
                        "viewVisitModal"
                    );


                var modal =
                    bootstrap.Modal.getOrCreateInstance(
                        modalElement
                    );


                modal.show();

            })

            .catch(error => {

                console.error(error);

                alert(
                    "Unable to load visit details."
                );

            });

    }

</script>